    "from chronoflux import AgeTransformer\n",
    "from PIL import Image\n",
    "\n",
    "transformer = AgeTransformer(repo_id=\"ParisNeo/ChronoFlux\")\n",
    "img = Image.open(\"input.jpg\")\n",
    "result = transformer.transform(img, target_age=65)\n",
    "result.show()"
